{
  "appId": "com.chaesooyong.management",
  "appName": "채수용 수학",
  "webDir": "build",
  "plugins": {
    "StatusBar": {
      "style": "DEFAULT",
      "backgroundColor": "#ffffff"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "default",
      "resizeOnFullScreen": true
    }
  },
  "server": {
    "iosScheme": "https",
    "androidScheme": "https",
    "hostname": "localhost"
  }
}
