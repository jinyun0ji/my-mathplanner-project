rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowedChatAttachmentType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'application/pdf'
      ];
    }

    function isAllowedChatAttachmentSize() {
      return (
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.size <= 5 * 1024 * 1024
      ) || (
        request.resource.contentType == 'application/pdf'
        && request.resource.size <= 10 * 1024 * 1024
      );
    }

    match /chat-attachments/{roomId}/{fileName} {
      // TODO: Restrict to chatRooms/{roomId}.participantIds after Storage rules can reliably share the same project Firestore lookup in all environments.
      allow read: if signedIn();
      allow write: if signedIn()
        && isAllowedChatAttachmentType()
        && isAllowedChatAttachmentSize();
    }
  }
}
