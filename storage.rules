rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowedChatAttachmentType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'application/pdf'
      ];
    }

    function isAllowedChatAttachmentSize() {
      return (
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.size <= 5 * 1024 * 1024
      ) || (
        request.resource.contentType == 'application/pdf'
        && request.resource.size <= 10 * 1024 * 1024
      );
    }

    match /chat-attachments/{roomId}/{fileName} {
      allow read: if signedIn();

      allow write: if signedIn()
        && isAllowedChatAttachmentType()
        && isAllowedChatAttachmentSize();
    }

    match /lesson-materials/{allPaths=**} {
      allow read: if signedIn();

      // 임시 복구용: 로그인 사용자 업로드 허용
      allow write: if signedIn()
        && request.resource.size <= 30 * 1024 * 1024;
    }
  }
}