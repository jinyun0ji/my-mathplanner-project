 export const formatGradeLabel = (grade) => {
     if (grade === null || grade === undefined) return '';
     const raw = grade.toString().trim();
     if (!raw) return '';
 
     const normalized = raw
         .replace(/^(고)+/, '고')
         .replace(/^(중)+/, '중')
         .replace(/^(초)+/, '초');
 
     if (/^[고중초]/.test(normalized)) return normalized;
     return `고${normalized}`;
 };
 
