+            let count = (item["videosCount"] as? NSNumber)?.intValue ?? (item["videosCount"] as? Int) ?? 0
+            let firstVideoId = ((item["firstVideoId"] as? String) ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
