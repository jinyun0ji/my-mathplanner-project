+<!doctype html>
+<html lang="ko">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
+  <title>YouTube Player</title>
+  <style>
+    html, body, #player {
+      width: 100%;
+      height: 100%;
+      margin: 0;
+      padding: 0;
+      overflow: hidden;
+      background: #000;
+    }
+    body { display: flex; }
+  </style>
+</head>
+<body>
+  <div id="player"></div>
+  <script>
+    (function () {
+      var YOUTUBE_ORIGIN = 'https://localhost';
+      var params = new URLSearchParams(window.location.search);
+      var videoId = params.get('videoId') || '';
+      var startSeconds = Number(params.get('startSeconds') || 0) || 0;
+      var player = null;
+      var tickTimer = null;
+
+      function sendMessage(payload) {
+        window.parent.postMessage(Object.assign({ source: 'youtube-proxy-player' }, payload), '*');
+      }
+
+      function getPlayerSnapshot() {
+        if (!player || typeof player.getCurrentTime !== 'function') {
+          return { currentTime: 0, duration: 0, state: null };
+        }
+
+        return {
+          currentTime: Number(player.getCurrentTime() || 0),
+          duration: Number(player.getDuration() || 0),
+          state: typeof player.getPlayerState === 'function' ? player.getPlayerState() : null,
+        };
+      }
+
+      function sendTick() {
+        sendMessage(Object.assign({ type: 'tick' }, getPlayerSnapshot()));
+      }
+
+      function startTicker() {
+        if (tickTimer) return;
+        tickTimer = window.setInterval(sendTick, 1000);
+      }
+
+      function stopTicker() {
+        if (!tickTimer) return;
+        window.clearInterval(tickTimer);
+        tickTimer = null;
+      }
+
+      function handleCommand(event) {
+        var data = event.data || {};
+        if (!data || data.source !== 'youtube-proxy-parent' || !player) return;
+
+        if (data.type === 'getCurrentTime') {
+          sendMessage({ type: 'currentTime', requestId: data.requestId, currentTime: getPlayerSnapshot().currentTime });
+          return;
+        }
+
+        if (data.type === 'getDuration') {
+          sendMessage({ type: 'duration', requestId: data.requestId, duration: getPlayerSnapshot().duration });
+          return;
+        }
+
+        if (data.type === 'seekTo' && typeof player.seekTo === 'function') {
+          player.seekTo(Number(data.seconds || 0), true);
+          sendTick();
+        }
+      }
+
+      window.onYouTubeIframeAPIReady = function () {
+        if (!videoId) {
+          sendMessage({ type: 'error', errorCode: 'missing-video-id' });
+          return;
+        }
+
+        player = new window.YT.Player('player', {
+          width: '100%',
+          height: '100%',
+          videoId: videoId,
+          playerVars: {
+            autoplay: 1,
+            controls: 1,
+            rel: 0,
+            modestbranding: 1,
+            playsinline: 1,
+            enablejsapi: 1,
+            origin: YOUTUBE_ORIGIN,
+            start: Math.max(0, Math.floor(startSeconds)),
+          },
+          events: {
+            onReady: function () {
+              sendMessage(Object.assign({ type: 'ready' }, getPlayerSnapshot()));
+              startTicker();
+            },
+            onStateChange: function (event) {
+              sendMessage(Object.assign({ type: 'state', state: event.data }, getPlayerSnapshot()));
+              startTicker();
+            },
+            onError: function (event) {
+              stopTicker();
+              sendMessage({ type: 'error', errorCode: event.data });
+            }
+          }
+        });
+      };
+
+      window.addEventListener('message', handleCommand);
+
+      var tag = document.createElement('script');
+      tag.src = 'https://www.youtube.com/iframe_api';
+      document.head.appendChild(tag);
+    }());
+  </script>
+</body>
+</html>
