diff --git a/firestore.rules b/firestore.rules
index 2b0dd4cbeda02ba40931243c4b8f8d1f061ba29e..6fd52eed3c5c3c3aee58cb222a0ba8a0a93241ac 100644
--- a/firestore.rules
+++ b/firestore.rules
@@ -782,76 +782,88 @@ service cloud.firestore {
             || (request.resource.data.studentId is string && isMyStudentUid(request.resource.data.studentId))
           )
         );
     }
 
     match /invites/{inviteId} {
       allow get: if signedIn();
       allow list: if isStaffOrAdminOrTeacher();
       allow create, delete: if isStaffOrAdminOrTeacher();
       allow update: if isStaffOrAdminOrTeacher()
         || (
           signedIn()
           && resource.data.consumed == false
           && request.resource.data.consumed == true
           && request.resource.data.consumedByAuthUid == uid()
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumed', 'consumedByAuthUid', 'consumedAt'])
         );
     }
 
     match /accountLinks/{authUid} {
       allow get: if request.auth != null && request.auth.uid == authUid;
       allow list: if false;
       allow create, update, delete: if false;
     }
 
+    function isAuthUidOrLinkedUserDocId(userUid) {
+      return signedIn()
+        && userUid is string
+        && (
+          uid() == userUid
+          || (
+            authIndex() != null
+            && authIndex().data.userDocId == userUid
+          )
+        );
+    }
+
+    function canAccessNotificationOwner(userUid) {
+      return isAuthUidOrLinkedUserDocId(userUid) || isStaffOrAdminOrTeacher();
+    }
+
     match /notifications/{logId} {
       allow read, write: if isStaffOrAdminOrTeacher();
     }
 
     match /notifications/{userUid}/items/{notificationId} {
-      allow read: if signedIn()
-        && (uid() == userUid || isStaffOrAdminOrTeacher());
+      allow read: if canAccessNotificationOwner(userUid);
 
-      // ✅ 본인: 읽음 처리용 update만 허용
-      allow update: if signedIn()
-        && uid() == userUid
+      // ✅ 본인: 읽음 처리용 update만 허용 (authUid 또는 연결된 userDocId 모두 허용)
+      allow update: if canAccessNotificationOwner(userUid)
         && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['isRead', 'readAt', 'updatedAt']);
 
       // ✅ 직원/관리자/강사: 기존대로 full 권한
       allow create, update, delete: if isStaffOrAdminOrTeacher();
     }
 
     match /notifications/{userUid}/meta {
-      allow read, write: if signedIn()
-        && (uid() == userUid || isStaffOrAdminOrTeacher());
+      allow read, write: if canAccessNotificationOwner(userUid);
     }
     
     match /notifications/{userUid}/meta/{metaId} {
-      allow read, write: if signedIn()
-        && (uid() == userUid || isStaffOrAdminOrTeacher());
+      allow read, write: if canAccessNotificationOwner(userUid);
     }
     
     
     match /userChatRooms/{ownerUid} {
       allow get, list, read: if request.auth != null
         && (request.auth.uid == ownerUid || isStaffOrAdminOrTeacher());
       allow write: if isStaffOrAdminOrTeacher();
 
       match /rooms/{roomId} {
         allow get, list, read: if request.auth != null
           && (request.auth.uid == ownerUid || isStaffOrAdminOrTeacher());
         allow create, update, delete: if isStaffOrAdminOrTeacher();
       }
     }
 
     match /chatRooms/{roomId} {
       allow get, list: if canReadChatRoom(resource.data);
 
       allow create: if isSignedIn()
         && (
           isStaffOrAdminOrTeacher()
           || isValidParentDirectChatRoomCreate()
           || isValidStudentDirectChatRoomCreate()
         );
 
