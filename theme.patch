+const formatTimestamp = (value) => {
+  const date = value?.toDate?.();
+  if (!date) return '-';
+  return new Intl.DateTimeFormat('ko-KR', {
+    year: 'numeric',
+    month: '2-digit',
+    day: '2-digit',
+    hour: '2-digit',
+    minute: '2-digit',
