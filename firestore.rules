rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function signedIn() { return isSignedIn(); }
    function uid() { return request.auth.uid; }
    function isSelf(targetUid) { return isSignedIn() && uid() == targetUid; }

    /** ✅ B안: authUid -> userDocId/role 인덱스 */
    function authIndex() {
      return isSignedIn() && exists(/databases/$(database)/documents/userAuthIndex/$(uid()))
        ? get(/databases/$(database)/documents/userAuthIndex/$(uid()))
        : null;
    }

    /** ✅ 내 프로필 문서ID: 인덱스 있으면 userDocId, 없으면 기존 uid */
    function myProfileDocId() {
      return authIndex() != null
        ? authIndex().data.userDocId
        : uid();
    }

    /** ✅ 내 역할: 인덱스 role 우선, 없으면 기존 users/{uid}.role */
    function userRole() {
      return authIndex() != null
        ? authIndex().data.role
        : (exists(/databases/$(database)/documents/users/$(uid()))
            ? get(/databases/$(database)/documents/users/$(uid())).data.role
            : null);
    }

    /** ✅ 내 프로필 문서: users/{myProfileDocId()} */
    function userDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(myProfileDocId()))
        ? get(/databases/$(database)/documents/users/$(myProfileDocId()))
        : null;
    }

    function resourceRole() { return resource != null ? resource.data.role : null; }
    function requestRole() { return request.resource.data.role; }
    function isResourceRole(role) { return resourceRole() == role; }
    function isRequestRole(role) { return requestRole() == role; }

    function isAdminOrStaff() { return userRole() in ['admin', 'staff', 'teaching', 'staffOrTeaching', 'teacher']; }
    function isAdmin() { return userRole() == 'admin'; }
    function isStaff() { return userRole() == 'staff'; }
    function isTeacher() { return userRole() in ['teacher', 'teaching', 'staffOrTeaching']; }
    function isStaffOrTeacher() { return isStaff() || isTeacher(); }
    function isStaffOrAdmin() { return isStaff() || isAdmin(); }
    function isStaffOrAdminOrTeacher() { return isAdminOrStaff(); }
    function isStudent() { return userRole() == 'student'; }
    function isParent() { return userRole() == 'parent'; }

    /** ✅ 학생이면: 내 학생 문서ID = myProfileDocId() */
    function getMyStudentId() {
      return isSignedIn() && isStudent() ? myProfileDocId() : null;
    }

    /** 부모의 연결 학생들 */
    function parentStudentUids() {
      return isParent() && userDoc() != null && userDoc().data.studentIds != null
        ? userDoc().data.studentIds
        : [];
    }

    function parentStudentIds() {
      return isParent() && userDoc() != null && userDoc().data.studentId is string
        ? [userDoc().data.studentId]
        : [];
    }

    function parentHasStudentAccess(studentId) {
      return studentId is string && (
        studentId in parentStudentUids()
        || studentId in parentStudentIds()
        || studentId == getMyStudentId()
      );
    }

    function listContainsAny(list, candidates) {
      return (candidates.size() > 0 && candidates[0] in list)
        || (candidates.size() > 1 && candidates[1] in list)
        || (candidates.size() > 2 && candidates[2] in list)
        || (candidates.size() > 3 && candidates[3] in list)
        || (candidates.size() > 4 && candidates[4] in list);
    }

    /** ✅ 학생/부모 소속 판단: authUid / studentDocId 둘 다 인정 */
    function isMyStudentUid(value) {
      return isSignedIn() && (
        // 1) value가 authUid인 경우(기존)
        value == uid()

        // 2) value가 studentDocId인 경우: 그 users 문서의 authUid가 내 uid
        || (
          value is string
          && exists(/databases/$(database)/documents/users/$(value))
          && get(/databases/$(database)/documents/users/$(value)).data.authUid == uid()
        )

        // 3) 학생 본인 docId (B안)
        || (isStudent() && value == getMyStudentId())

        // 4) 부모의 studentIds
        || (isParent() && value in parentStudentUids())
      );
    }

    /** ✅ 클래스 멤버 체크: classIds 우선 + classes.students 보조(복원) */
    function isClassMember(classId) {
      return isSignedIn()
        && classId is string
        && (
          // 1) 학생: 내 users 문서의 classIds (신규)
          (isStudent() && (classId in myClassIds()))

          // 2) 부모: 자녀 users 문서의 classIds (신규)
          || (isParent() && parentHasClassId(classId))

          // 3) 보조(레거시/안전망): classes/{classId}.students 배열 기준
          || (
            exists(/databases/$(database)/documents/classes/$(classId))
            && (
              // 레거시: authUid가 students에 남아있던 경우
              (uid() in get(/databases/$(database)/documents/classes/$(classId)).data.students)
              // 신규 권장: studentDocId(users 문서ID)
              || (myProfileDocId() in get(/databases/$(database)/documents/classes/$(classId)).data.students)
              // 기존에 쓰던 userAuthIndex 기반(혹시 값이 다를 때)
              || (myStudentDocId() != null && myStudentDocId() in get(/databases/$(database)/documents/classes/$(classId)).data.students)
              // 부모: 자녀들 중 하나라도 students에 들어있으면 OK
              || (isParent() && listContainsAny(
                  get(/databases/$(database)/documents/classes/$(classId)).data.students,
                  parentStudentUids()
              ))
            )
          )
        );
    }
    
    function isAnnouncementTargetClass(data) {
      return data != null
        && ('targetClasses' in data)
        && (data.targetClasses is list)
        && (
          (data.targetClasses.size() > 0 && isClassMember(data.targetClasses[0]))
          || (data.targetClasses.size() > 1 && isClassMember(data.targetClasses[1]))
          || (data.targetClasses.size() > 2 && isClassMember(data.targetClasses[2]))
          || (data.targetClasses.size() > 3 && isClassMember(data.targetClasses[3]))
          || (data.targetClasses.size() > 4 && isClassMember(data.targetClasses[4]))
          || (data.targetClasses.size() > 5 && isClassMember(data.targetClasses[5]))
          || (data.targetClasses.size() > 6 && isClassMember(data.targetClasses[6]))
          || (data.targetClasses.size() > 7 && isClassMember(data.targetClasses[7]))
          || (data.targetClasses.size() > 8 && isClassMember(data.targetClasses[8]))
          || (data.targetClasses.size() > 9 && isClassMember(data.targetClasses[9]))
        );
    }

    function isAnnouncementTargetStudent(data) {
      return data != null
        && ('targetStudents' in data)
        && (data.targetStudents is list)
        && (
          (data.targetStudents.size() > 0 && isMyStudentUid(data.targetStudents[0]))
          || (data.targetStudents.size() > 1 && isMyStudentUid(data.targetStudents[1]))
          || (data.targetStudents.size() > 2 && isMyStudentUid(data.targetStudents[2]))
          || (data.targetStudents.size() > 3 && isMyStudentUid(data.targetStudents[3]))
          || (data.targetStudents.size() > 4 && isMyStudentUid(data.targetStudents[4]))
          || (data.targetStudents.size() > 5 && isMyStudentUid(data.targetStudents[5]))
          || (data.targetStudents.size() > 6 && isMyStudentUid(data.targetStudents[6]))
          || (data.targetStudents.size() > 7 && isMyStudentUid(data.targetStudents[7]))
          || (data.targetStudents.size() > 8 && isMyStudentUid(data.targetStudents[8]))
          || (data.targetStudents.size() > 9 && isMyStudentUid(data.targetStudents[9]))
        );
    }

    function isAnnouncementTargetAuthUid(data) {
      return data != null
        && ('targetAuthUids' in data)
        && (data.targetAuthUids is list)
        && (uid() in data.targetAuthUids);
    }

    function hasValidInvite(inviteId, role) {
      return inviteId is string
        && exists(/databases/$(database)/documents/invites/$(inviteId))
        && get(/databases/$(database)/documents/invites/$(inviteId)).data.consumed == false
        && get(/databases/$(database)/documents/invites/$(inviteId)).data.role == role
        && (
          get(/databases/$(database)/documents/invites/$(inviteId)).data.expiresAt == null
          || get(/databases/$(database)/documents/invites/$(inviteId)).data.expiresAt > request.time
        );
    }
    
    function pickStudentKey(data) {
      return (data != null && ('studentUid' in data)) ? data.studentUid
        : (data != null && ('studentId' in data)) ? data.studentId
        : (data != null && ('authUid' in data)) ? data.authUid
        : null;
    }

    function isMineByAnyKey(data) {
      return isMyStudentUid(pickStudentKey(data));
    }
    
    function isMyChild(userId) {
      return isParent()
        && userDoc() != null
        && userDoc().data.studentIds != null
        && userId in userDoc().data.studentIds;
    }
    
    function isMyChildDoc(userId) {
      return isParent() && (userId in parentStudentUids());
    }
    
    function asList(v) {
      return (v is list) ? v : [];
    }

    function myUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function myRole() {
      return userRole();
    }

    // student / parent 가 "내 학생 키들"을 최대 10개로 만든다.
    function viewerStudentKeys() {
      // 내 auth uid
      let u = request.auth.uid;
      let me = myUserDoc();

      // 학생 본인: 내 users 문서 id, 내 uid(필드), 내 auth uid 를 모두 후보로
      let studentKeys = [
        u,
        ((me != null) ? me.id : null),
        ((me != null && ('uid' in me.data)) ? me.data.uid : null),
        ((me != null && ('authUid' in me.data)) ? me.data.authUid : null)
      ];

      // 학부모: 내 users 문서의 studentIds (학생 문서ID 배열)
      let childIds = (me != null) ? asList(me.data.studentIds) : [];

      // role이 parent면 childIds를 쓰고, 아니면 studentKeys를 쓴다.
      // (여기서 null 제거는 rules에서 직접 못하니 아래 contains 검사에서 방어)
      return (myRole() == 'parent') ? childIds.slice(0, 10) : studentKeys.slice(0, 10);
    }

    function anyViewerKeyInList(keys, listField) {
      return (listField is list) && (
        (keys.size() > 0 && keys[0] != null && keys[0] in listField) ||
        (keys.size() > 1 && keys[1] != null && keys[1] in listField) ||
        (keys.size() > 2 && keys[2] != null && keys[2] in listField) ||
        (keys.size() > 3 && keys[3] != null && keys[3] in listField) ||
        (keys.size() > 4 && keys[4] != null && keys[4] in listField) ||
        (keys.size() > 5 && keys[5] != null && keys[5] in listField) ||
        (keys.size() > 6 && keys[6] != null && keys[6] in listField) ||
        (keys.size() > 7 && keys[7] != null && keys[7] in listField) ||
        (keys.size() > 8 && keys[8] != null && keys[8] in listField) ||
        (keys.size() > 9 && keys[9] != null && keys[9] in listField)
      );
    }

    function isViewerClassMember() {
      let keys = viewerStudentKeys();
      return anyViewerKeyInList(keys, resource.data.students);
    }
    
    function myStudentDocId() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/userAuthIndex/$(uid()))
        ? get(/databases/$(database)/documents/userAuthIndex/$(uid())).data.userDocId
        : null;
    }
    
    function resourceParticipantIds() {
      return resource != null && resource.data.participantIds is list
        ? resource.data.participantIds
        : [];
    }
    function isChatParticipantFromResource() {
      return isSignedIn() && (uid() in resourceParticipantIds());
    }

    function isLegacyChatParticipantData(data) {
      return isSignedIn() && data != null && (
        (data.participantIds is list && uid() in data.participantIds)
        || (data.participants is list && uid() in data.participants)
        || (data.participantUids is list && uid() in data.participantUids)
        || (data.parentUid is string && data.parentUid == uid())
        || (data.parentUids is list && uid() in data.parentUids)
      );
    }

    function canAccessLegacyChatData(data) {
      return isSignedIn() && data != null && (
        isStaffOrAdminOrTeacher()
        || isLegacyChatParticipantData(data)
        || parentHasStudentAccess(data.studentId)
      );
    }

    function canAccessChatRoomDoc() {
      return isSignedIn() && (
        isStaffOrAdminOrTeacher()
        || isChatParticipantFromResource()
      );
    }

    function canAccessChatRoomById(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chatRooms/$(roomId))
        && (
          isStaffOrAdminOrTeacher()
          || (uid() in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participantIds)
        );
    }

    function isAllowedChatRoomUpdateFieldSet() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['updatedAt', 'updatedBy', 'lastMessageText', 'lastMessageAt', 'lastMessageSenderId', 'unreadCountByUser', 'status']);
    }

    function isValidDirectChatRoomPatch() {
      return isAllowedChatRoomUpdateFieldSet()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantRoles == resource.data.participantRoles
        && request.resource.data.internalOnly == resource.data.internalOnly
        && request.resource.data.updatedBy == uid()
        && request.resource.data.lastMessageSenderId == uid();
    }

    function isAllowedChatMessageCreateFields() {
      return request.resource.data.keys().hasOnly([
        'roomId',
        'senderId',
        'senderRole',
        'senderName',
        'messageType',
        'text',
        'attachments',
        'createdAt',
        'internalOnly',
        'clientTempId',
        'readBy',
        'isBroadcastCopy',
        'broadcastId',
        'editedAt',
        'deletedAt'
      ]);
    }

    function isValidDirectChatMessageCreate(roomId) {
      return canAccessChatRoomById(roomId)
        && request.resource.data.roomId == roomId
        && request.resource.data.senderId == uid()
        && request.resource.data.messageType == 'text'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.internalOnly == true
        && (!('attachments' in request.resource.data) || request.resource.data.attachments is list)
        && (!('senderRole' in request.resource.data) || request.resource.data.senderRole is string || request.resource.data.senderRole == null)
        && (!('senderName' in request.resource.data) || request.resource.data.senderName is string || request.resource.data.senderName == null)
        && (!('clientTempId' in request.resource.data) || request.resource.data.clientTempId is string || request.resource.data.clientTempId == null)
        && (!('isBroadcastCopy' in request.resource.data) || request.resource.data.isBroadcastCopy == false || request.resource.data.isBroadcastCopy == null)
        && (!('broadcastId' in request.resource.data) || request.resource.data.broadcastId == null);
    }

    /* =========================
       users
    ========================= */
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }
    
    match /users/{studentId}/staffMemos/{memoId} {
      allow read, write: if request.auth != null && isStaffOrAdminOrTeacher();
    }

    // ✅ userAuthIndex 읽기 허용 유지
    match /userAuthIndex/{u} { allow read: if request.auth.uid == u; }

    /* =========================
       classes
    ========================= */
    // 정책: classes.students에는 studentDocId(users 문서ID)만 저장을 권장.
    // 레거시(authUid) 조회는 당분간 유지하지만, 데이터는 점진적으로 정리한다.
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }
    
    match /closures/{closureId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaffOrAdminOrTeacher();
    }

    /* =========================
       tests / lessonLogs / homeworkAssignments 등
       (여기는 기존대로 두되, isClassMember가 B안 대응되었기 때문에 대부분 살아남)
    ========================= */
    match /tests/{docId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }
    
    match /classTestStats/{id} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    match /lessonLogs/{docId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }

    match /attendanceLogs/{docId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }

    match /clinicLogs/{docId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }
    
    // clinicReservations: 학생/부모는 본인 예약 read, 직원은 전체
    match /clinicReservations/{docId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }

    match /clinicSessions/{docId} {
      allow read, get, list: if isStaffOrAdminOrTeacher()
        || (isSignedIn() && isMyStudentUid(resource.data.studentDocId));
      allow write: if isStaffOrAdminOrTeacher();
    }

    match /clinicNotifications/{docId} {
      allow read, get, list: if isStaffOrAdminOrTeacher();
      allow write: if isStaffOrAdminOrTeacher();
    }

    match /workLogs/{docId} {
      allow read, list: if isStaffOrAdminOrTeacher();
      allow write: if isStaffOrAdminOrTeacher();
    }
    
    match /auditLogs/{docId} {
      allow read, list: if isStaffOrAdminOrTeacher();
      allow create, update, delete: if false;
    }

    match /errorLogs/{docId} {
      allow read, list: if isStaffOrAdminOrTeacher();

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt is string
        && request.resource.data.level in ['error', 'warn']
        && request.resource.data.diff({}).affectedKeys().hasOnly([
          'level',
          'scope',
          'action',
          'message',
          'code',
          'context',
          'createdBy',
          'createdAt',
          'app',
          'route',
          'build',
          'userRole'
        ]);

      allow update, delete: if false;
    }

    match /announcements/{docId} {
      allow read: if isStaffOrAdminOrTeacher()
        || (
          signedIn()
          && (
            resource.data.isPublic == true
            || isAnnouncementTargetClass(resource.data)
            || isAnnouncementTargetStudent(resource.data)
            || isAnnouncementTargetAuthUid(resource.data)
          )
        );

      allow write: if isStaffOrAdminOrTeacher();
    }

    match /homeworkAssignments/{docId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }

    match /materials/{docId} {
      allow read, list: if isStaffOrAdminOrTeacher();
      allow create, update, delete: if isStaffOrAdminOrTeacher();
    }

    match /books/{docId} {
      allow read, list: if isStaffOrAdminOrTeacher();
      allow create, update, delete: if isStaffOrAdminOrTeacher();
    }

    match /payments/{docId} {
      allow read, write, list: if isStaffOrAdminOrTeacher();
      allow create, update, delete: if isStaffOrAdminOrTeacher();
    }

    match /grades/{docId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }

    match /homeworkResults/{docId} {
      allow read: if signedIn();
      allow write: if isStaffOrAdminOrTeacher();
    }

    match /lessonReports/{docId} {
      allow read: if isStaffOrAdminOrTeacher()
        || (isStudent() && resource.data.status == 'sent' && isMyStudentUid(resource.data.studentId))
        || (isParent() && resource.data.status == 'sent' && isMyChildDoc(resource.data.studentId));
      allow create, update: if isStaffOrAdminOrTeacher();
      allow delete: if false;
    }

    match /videoProgress/{docId} {
      allow read: if signedIn();
      allow write: if isSignedIn() && isMyStudentUid(pickStudentKey(request.resource.data));
    }
    
    match /videoMemos/{uid}/items/{memoId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /externalSchedules/{docId} {
      allow read: if signedIn();

      // ✅ write도 동일 기준
      allow write: if isStaffOrAdminOrTeacher()
        || (
          isSignedIn()
          && (
            (request.resource.data.authUid is string && isMyStudentUid(request.resource.data.authUid))
            || (request.resource.data.studentId is string && isMyStudentUid(request.resource.data.studentId))
          )
        );
    }

    match /invites/{inviteId} {
      allow get: if signedIn();
      allow list: if isStaffOrAdminOrTeacher();
      allow create, delete: if isStaffOrAdminOrTeacher();
      allow update: if isStaffOrAdminOrTeacher()
        || (
          signedIn()
          && resource.data.consumed == false
          && request.resource.data.consumed == true
          && request.resource.data.consumedByAuthUid == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumed', 'consumedByAuthUid', 'consumedAt'])
        );
    }

    match /accountLinks/{authUid} {
      allow get: if request.auth != null && request.auth.uid == authUid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /notifications/{logId} {
      allow read, write: if isStaffOrAdminOrTeacher();
    }

    match /notifications/{userUid}/items/{notificationId} {
      allow read: if signedIn()
        && (uid() == userUid || isStaffOrAdminOrTeacher());

      // ✅ 본인: 읽음 처리용 update만 허용
      allow update: if signedIn()
        && uid() == userUid
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['isRead', 'readAt', 'updatedAt']);

      // ✅ 직원/관리자/강사: 기존대로 full 권한
      allow create, update, delete: if isStaffOrAdminOrTeacher();
    }

    match /notifications/{userUid}/meta {
      allow read, write: if signedIn()
        && (uid() == userUid || isStaffOrAdminOrTeacher());
    }
    
    match /notifications/{userUid}/meta/{metaId} {
      allow read, write: if signedIn()
        && (uid() == userUid || isStaffOrAdminOrTeacher());
    }
    
    
    match /chatRooms/{roomId} {
      allow read: if canAccessChatRoomDoc();

      allow create: if isSignedIn()
        && isStaffOrAdminOrTeacher()
        && request.resource.data.type == 'individual'
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.internalOnly == true;

      allow update: if isSignedIn() && (
        isStaffOrAdminOrTeacher()
        || (
          isChatParticipantFromResource()
          && isValidDirectChatRoomPatch()
        )
      );

      allow delete: if isStaffOrAdminOrTeacher();
    }

    match /chatRooms/{roomId}/messages/{messageId} {
      allow read: if canAccessChatRoomById(roomId);

      allow create: if isAllowedChatMessageCreateFields()
        && isValidDirectChatMessageCreate(roomId);

      allow update: if isStaffOrAdminOrTeacher();
      allow delete: if false;
    }

    match /chatBroadcastLogs/{broadcastId} {
      allow read, write: if isStaffOrAdminOrTeacher();
    }

    match /chats/{roomId} {
      allow get: if canAccessLegacyChatData(resource.data);
      allow list: if isStaffOrAdminOrTeacher() || isLegacyChatParticipantData(resource.data);

      allow create: if isSignedIn();

      allow update: if canAccessLegacyChatData(resource.data);
      allow delete: if isStaffOrAdminOrTeacher();
    }

    match /chats/{roomId}/messages/{messageId} {
      allow read: if canAccessLegacyChatData(get(/databases/$(database)/documents/chats/$(roomId)).data);

      allow create: if canAccessLegacyChatData(get(/databases/$(database)/documents/chats/$(roomId)).data);

      allow update, delete: if isStaffOrAdminOrTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}